        {
          "id": "stats-experimentation-ab-tests-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"mSxP\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='ae90123e-f2bb-2045-b1d9-2ab58e39aafd' random-id='ae90123e-f2bb-2045-b1d9-2ab58e39aafd'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _absolute, _relative = _ns[&#92;&quot;absolute_and_relative_lift&#92;&quot;](0.10, 0.12)&#92;n    assert abs(_absolute - 0.02) &#92;u003c 1e-12 and abs(_relative - 0.20) &#92;u003c 1e-12&#92;n    try:&#92;n        _ns[&#92;&quot;absolute_and_relative_lift&#92;&quot;](0, 0.1)&#92;n    except ValueError:&#92;n        pass&#92;n    else:&#92;n        raise AssertionError(&#92;&quot;zero control must raise ValueError&#92;&quot;)&#92;n    return _ns&#92;n&#92;nproblem(mo, stats_exercise_08_description, stats_exercise_08_starter, _submission, stats_exercise_08_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Implement <code>absolute_and_relative_lift(control, treatment)</code> returning both\nlifts, and raise <code>ValueError</code> when the control rate is zero.</span></span><marimo-ui-element object-id='jXAc-0' random-id='1075dd44-5368-ed79-8a35-087a6cf5cb36'><marimo-code-editor data-initial-value='&quot;def absolute_and_relative_lift(control, treatment):&#92;n    if control == 0:&#92;n        raise ValueError(&#92;&quot;relative lift is undefined&#92;&quot;)&#92;n    absolute = treatment - control&#92;n    return absolute, absolute / control&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='170' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='jXAc-1' random-id='386aeda8-673d-4d0e-c209-acdf247fc3f3'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_ns%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_ns%20%3D%20execute_submission(source)%0A%20%20%20%20_absolute%2C%20_relative%20%3D%20_ns%5B%22absolute_and_relative_lift%22%5D(0.10%2C%200.12)%0A%20%20%20%20assert%20abs(_absolute%20-%200.02)%20%3C%201e-12%20and%20abs(_relative%20-%200.20)%20%3C%201e-12%0A%20%20%20%20try%3A%0A%20%20%20%20%20%20%20%20_ns%5B%22absolute_and_relative_lift%22%5D(0%2C%200.1)%0A%20%20%20%20except%20ValueError%3A%0A%20%20%20%20%20%20%20%20pass%0A%20%20%20%20else%3A%0A%20%20%20%20%20%20%20%20raise%20AssertionError(%22zero%20control%20must%20raise%20ValueError%22)%0A%20%20%20%20return%20_ns%0A%0Aproblem(mo%2C%20stats_exercise_08_description%2C%20stats_exercise_08_starter%2C%20_submission%2C%20stats_exercise_08_submit)</marimo-cell-code>\n        </marimo-island>",
          "visible": true
        }
