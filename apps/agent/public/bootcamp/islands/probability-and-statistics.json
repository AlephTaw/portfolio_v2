    {
      "id": "stats-expectation-variance-covariance",
      "blocks": [
        {
          "id": "stats-expectation-variance-covariance-block-3",
          "html": "<marimo-island\n    data-app-id=\"mlphd\"\n    data-cell-id=\"aWBL\"\n    data-reactive=\"true\"\n>\n    <marimo-cell-output>\n    <span></span>\n    </marimo-cell-output>\n    <marimo-cell-code hidden>stats_exercise_04_description%20%3D%20mo.md(%22%22%22%0A%23%23%23%20Exercise%0A%0AImplement%20population%20%60mean(values)%60%20and%20%60variance(values)%60.%0A%22%22%22)%0Astats_exercise_04_starter%20%3D%20mo.ui.code_editor(%0A%20%20%20%20value%3D'def%20mean(values)%3A%5Cn%20%20%20%20return%20sum(values)%20%2F%20len(values)%5Cn%5Cndef%20variance(values)%3A%5Cn%20%20%20%20center%20%3D%20mean(values)%5Cn%20%20%20%20return%20sum((value%20-%20center)%20**%202%20for%20value%20in%20values)%20%2F%20len(values)'%2C%0A%20%20%20%20language%3D%22python%22%2C%20label%3D%22Your%20Python%20answer%22%2C%20min_height%3D190%2C%0A)%0Astats_exercise_04_submit%20%3D%20mo.ui.run_button(label%3D%22Submit%20answer%22)</marimo-cell-code>\n</marimo-island>",
          "visible": false
        },
        {
          "id": "stats-expectation-variance-covariance-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"MIsd\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='1ebd8b77-7b75-f56a-dbd4-b4c904bee4dc' random-id='1ebd8b77-7b75-f56a-dbd4-b4c904bee4dc'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    assert abs(_ns[&#92;&quot;mean&#92;&quot;]([1, 2, 3, 4]) - 2.5) &#92;u003c 1e-12&#92;n    assert abs(_ns[&#92;&quot;variance&#92;&quot;]([1, 2, 3, 4]) - 1.25) &#92;u003c 1e-12&#92;n    assert abs(_ns[&#92;&quot;variance&#92;&quot;]([7, 7, 7])) &#92;u003c 1e-12&#92;n    return _ns&#92;n&#92;nproblem(mo, stats_exercise_04_description, stats_exercise_04_starter, _submission, stats_exercise_04_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Implement population <code>mean(values)</code> and <code>variance(values)</code>.</span></span><marimo-ui-element object-id='aWBL-0' random-id='dd5acafd-9e7f-368a-d19e-e1847c9e06b7'><marimo-code-editor data-initial-value='&quot;def mean(values):&#92;n    return sum(values) / len(values)&#92;n&#92;ndef variance(values):&#92;n    center = mean(values)&#92;n    return sum((value - center) ** 2 for value in values) / len(values)&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#9