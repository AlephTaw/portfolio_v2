        {
          "id": "stats-estimation-confidence-intervals-block-3",
          "html": "<marimo-island\n    data-app-id=\"mlphd\"\n    data-cell-id=\"wlyU\"\n    data-reactive=\"true\"\n>\n    <marimo-cell-output>\n    <span></span>\n    </marimo-cell-output>\n    <marimo-cell-code hidden>stats_exercise_06_description%20%3D%20mo.md(%22%22%22%0A%23%23%23%20Exercise%0A%0AImplement%20%60confidence_interval(estimate%2C%20standard_error%2C%20critical%3D1.96)%60.%0A%22%22%22)%0Astats_exercise_06_starter%20%3D%20mo.ui.code_editor(%0A%20%20%20%20value%3D'def%20confidence_interval(estimate%2C%20standard_error%2C%20critical%3D1.96)%3A%5Cn%20%20%20%20margin%20%3D%20critical%20*%20standard_error%5Cn%20%20%20%20return%20estimate%20-%20margin%2C%20estimate%20%2B%20margin'%2C%0A%20%20%20%20language%3D%22python%22%2C%20label%3D%22Your%20Python%20answer%22%2C%20min_height%3D160%2C%0A)%0Astats_exercise_06_submit%20%3D%20mo.ui.run_button(label%3D%22Submit%20answer%22)</marimo-cell-code>\n</marimo-island>",
          "visible": false
        },
        {
          "id": "stats-estimation-confidence-intervals-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"PieA\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='bcb250f5-0fb5-6d85-e505-99098e134788' random-id='bcb250f5-0fb5-6d85-e505-99098e134788'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _low, _high = _ns[&#92;&quot;confidence_interval&#92;&quot;](10, 2)&#92;n    assert abs(_low - 6.08) &#92;u003c 1e-12 and abs(_high - 13.92) &#92;u003c 1e-12&#92;n    assert _ns[&#92;&quot;confidence_interval&#92;&quot;](5, 1, 2) == (3, 7)&#92;n    return _ns&#92;n&#92;nproblem(mo, stats_exercise_06_description, stats_exercise_06_starter, _submission, stats_exercise_06_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Implement <code>confidence_interval(estimate, standard_error, critical=1.96)</code>.</span></span><marimo-ui-element object-id='wlyU-0' random-id='2919a223-5a5d-9eae-157d-528f62bf5d9c'><marimo-code-editor data-initial-value='&quot;def confidence_interval(estimate, standard_error, critical=1.96):&#92;n    margin = critical * standard_error&#92;n    return estimate - margin, estimate + margin&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='160' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='wlyU-1' random-id='d8619d10-5117-bf71-2465-33279834416e'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_ns%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_ns%20%3D%20execute_submission(source)%0A%20%20%20%20_low%2C%20_high%20%3D%20_ns%5B%22confidence_interval%22%5D(10%2C%202)%0A%20%20%20%20assert%20abs(_low%20-%206.08)%20%3C%201e-12%20and%20abs(_high%20-%2013.92)%20%3C%201e-12%0A%20%20%20%20assert%20_ns%5B%22confidence_interval%22%5D(5%2C%201%2C%202)%20%3D%3D%20(3%2C%207)%0A%20%20%20%20return%20_ns%0A%0Aproblem(mo%2C%20stats_exercise_06_description%2C%20stats_exercise_06_starter%2C%20_submission%2C%20stats_exercise_06_submit)</marimo-cell-code>\n        </marimo-island>",
