          "html": "<marimo-island\n    data-app-id=\"mlphd\"\n    data-cell-id=\"upgv\"\n    data-reactive=\"true\"\n>\n    <marimo-cell-output>\n    <span></span>\n    </marimo-cell-output>\n    <marimo-cell-code hidden>stats_exercise_05_description%20%3D%20mo.md(%22%22%22%0A%23%23%23%20Exercise%0A%0AImplement%20%60standard_error(std_dev%2C%20sample_size)%60.%0A%22%22%22)%0Astats_exercise_05_starter%20%3D%20mo.ui.code_editor(%0A%20%20%20%20value%3D'import%20math%5Cn%5Cndef%20standard_error(std_dev%2C%20sample_size)%3A%5Cn%20%20%20%20return%20std_dev%20%2F%20math.sqrt(sample_size)'%2C%0A%20%20%20%20language%3D%22python%22%2C%20label%3D%22Your%20Python%20answer%22%2C%20min_height%3D150%2C%0A)%0Astats_exercise_05_submit%20%3D%20mo.ui.run_button(label%3D%22Submit%20answer%22)</marimo-cell-code>\n</marimo-island>",
