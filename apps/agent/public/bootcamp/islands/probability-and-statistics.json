        {
          "id": "stats-hypothesis-testing-power-block-3",
          "html": "<marimo-island\n    data-app-id=\"mlphd\"\n    data-cell-id=\"mySd\"\n    data-reactive=\"true\"\n>\n    <marimo-cell-output>\n    <span></span>\n    </marimo-cell-output>\n    <marimo-cell-code hidden>stats_exercise_07_description%20%3D%20mo.md(%22%22%22%0A%23%23%23%20Exercise%0A%0AImplement%20%60decision(p_value%2C%20alpha%3D0.05)%60%20returning%20%60%22reject%22%60%20or%0A%60%22fail_to_reject%22%60%2C%20and%20%60bonferroni_alpha(alpha%2C%20tests)%60.%0A%22%22%22)%0Astats_exercise_07_starter%20%3D%20mo.ui.code_editor(%0A%20%20%20%20value%3D'def%20decision(p_value%2C%20alpha%3D0.05)%3A%5Cn%20%20%20%20return%20%22reject%22%20if%20p_value%20%3C%20alpha%20else%20%22fail_to_reject%22%5Cn%5Cndef%20bonferroni_alpha(alpha%2C%20tests)%3A%5Cn%20%20%20%20return%20alpha%20%2F%20tests'%2C%0A%20%20%20%20language%3D%22python%22%2C%20label%3D%22Your%20Python%20answer%22%2C%20min_height%3D180%2C%0A)%0Astats_exercise_07_submit%20%3D%20mo.ui.run_button(label%3D%22Submit%20answer%22)</marimo-cell-code>\n</marimo-island>",
          "visible": false
        },
        {
          "id": "stats-hypothesis-testing-power-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"vGkK\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='40940a7c-f08e-0bc1-48c9-68edee582c9e' random-id='40940a7c-f08e-0bc1-48c9-68edee582c9e'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    assert _ns[&#92;&quot;decision&#92;&quot;](0.01) == &#92;&quot;reject&#92;&quot;&#92;n    assert _ns[&#92;&quot;decision&#92;&quot;](0.05) == &#92;&quot;fail_to_reject&#92;&quot;&#92;n    assert abs(_ns[&#92;&quot;bonferroni_alpha&#92;&quot;](0.05, 10) - 0.005) &#92;u003c 1e-12&#92;n    return _ns&#92;n&#92;nproblem(mo, stats_exercise_07_description, stats_exercise_07_starter, _submission, stats_exercise_07_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Implement <code>decision(p_value, alpha=0.05)</code> returning <code>\"reject\"</code> or\n<code>\"fail_to_reject\"</code>, and <code>bonferroni_alpha(alpha, tests)</code>.</span></span><marimo-ui-element object-id='mySd-0' random-id='1e4ab112-3730-a573-b821-885c98912638'><marimo-code-editor data-initial-value='&quot;def decision(p_value, alpha=0.05):&#92;n    return &#92;&quot;reject&#92;&quot; if p_value &#92;u003c alpha else &#92;&quot;fail_to_reject&#92;&quot;&#92;n&#92;ndef bonferroni_alpha(alpha, tests):&#92;n    return alpha / tests&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='180' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='mySd-1' random-id='121e02dd-cf70-4aa6-0eba-e9f053ce77f3'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_ns%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_ns%20%3D%20execute_submission(source)%0A%20%20%20%20assert%20_ns%5B%22decision%22%5D(0.01)%20%3D%3D%20%22reject%22%0A%20%20%20%20assert%20_ns%5B%22decision%22%5D(0.05)%20%3D%3D%20%22fail_to_reject%22%0A%20%20%20%20assert%20abs(_ns%5B%22bonferroni_alpha%22%5D(0.05%2C%2010)%20-%200.005)%20%3C%201e-12%0A%20%20%20%20return%20_ns%0A%0Aproblem(mo%2C%20stats_exercise_07_description%2C%20stats_exercise_07_starter%2C%20_submission%2C%20stats_exercise_07_submit)</marimo-cell-code>\n        </marimo-island>",
