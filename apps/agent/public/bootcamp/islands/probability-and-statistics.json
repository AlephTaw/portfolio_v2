        {
          "id": "stats-bayes-base-rates-block-3",
          "html": "<marimo-island\n    data-app-id=\"mlphd\"\n    data-cell-id=\"lQxp\"\n    data-reactive=\"true\"\n>\n    <marimo-cell-output>\n    <span></span>\n    </marimo-cell-output>\n    <marimo-cell-code hidden>stats_exercise_02_description%20%3D%20mo.md(%22%22%22%0A%23%23%23%20Exercise%0A%0AImplement%20%60positive_predictive_value(prevalence%2C%20sensitivity%2C%20specificity)%60.%0A%22%22%22)%0Astats_exercise_02_starter%20%3D%20mo.ui.code_editor(%0A%20%20%20%20value%3D'def%20positive_predictive_value(prevalence%2C%20sensitivity%2C%20specificity)%3A%5Cn%20%20%20%20true_positive%20%3D%20sensitivity%20*%20prevalence%5Cn%20%20%20%20false_positive%20%3D%20(1%20-%20specificity)%20*%20(1%20-%20prevalence)%5Cn%20%20%20%20return%20true_positive%20%2F%20(true_positive%20%2B%20false_positive)'%2C%0A%20%20%20%20language%3D%22python%22%2C%20label%3D%22Your%20Python%20answer%22%2C%20min_height%3D170%2C%0A)%0Astats_exercise_02_submit%20%3D%20mo.ui.run_button(label%3D%22Submit%20answer%22)</marimo-cell-code>\n</marimo-island>",
          "visible": false
        },
        {
          "id": "stats-bayes-base-rates-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"Plbk\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='6b9998f8-d153-319e-71b0-b0633aaa592d' random-id='6b9998f8-d153-319e-71b0-b0633aaa592d'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _fn = _ns[&#92;&quot;positive_predictive_value&#92;&quot;]&#92;n    assert abs(_fn(0.01, 0.99, 0.95) - (0.0099 / 0.0594)) &#92;u003c 1e-12&#92;n    assert abs(_fn(0.5, 1.0, 1.0) - 1.0) &#92;u003c 1e-12&#92;n    return _ns&#92;n&#92;nproblem(mo, stats_exercise_02_description, stats_exercise_02_starter, _submission, stats_exercise_02_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Implement <code>positive_predictive_value(prevalence, sensitivity, specificity)</code>.</span></span><marimo-ui-element object-id='lQxp-0' random-id='159cb78f-0696-b971-1feb-abf5ca39d7a0'><marimo-code-editor data-initial-value='&quot;def positive_predictive_value(prevalence, sensitivity, specificity):&#92;n    true_positive = sensitivity * prevalence&#92;n    false_positive = (1 - specificity) * (1 - prevalence)&#92;n    return true_positive / (true_positive + false_positive)&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='170' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='lQxp-1' random-id='623f06c1-1ff7-a039-b958-f1db18af5b4c'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_ns%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_ns%20%3D%20execute_submission(source)%0A%20%20%20%20_fn%20%3D%20_ns%5B%22positive_predictive_value%22%5D%0A%20%20%20%20assert%20abs(_fn(0.01%2C%200.99%2C%200.95)%20-%20(0.0099%20%2F%200.0594))%20%3C%201e-12%0A%20%20%20%20assert%20abs(_fn(0.5%2C%201.0%2C%201.0)%20-%201.0)%20%3C%201e-12%0A%20%20%20%20return%20_ns%0A%0Aproblem(mo%2C%20stats_exercise_02_description%2C%20stats_exercise_02_starter%2C%20_submission%2C%20stats_exercise_02_submit)</marimo-cell-code>\n        </marimo-island>",
