        {
          "id": "stats-sampling-clt-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"WJUG\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='5538c61d-9cbd-afd3-5971-ce8c422a43ba' random-id='5538c61d-9cbd-afd3-5971-ce8c422a43ba'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _fn = _ns[&#92;&quot;standard_error&#92;&quot;]&#92;n    assert abs(_fn(10, 100) - 1) &#92;u003c 1e-12&#92;n    assert abs(_fn(10, 400) - 0.5) &#92;u003c 1e-12&#92;n    return _ns&#92;n&#92;nproblem(mo, stats_exercise_05_description, stats_exercise_05_starter, _submission, stats_exercise_05_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Implement <code>standard_error(std_dev, sample_size)</code>.</span></span><marimo-ui-element object-id='upgv-0' random-id='20e3ec7d-a59e-6869-8bd8-26a44c5eea1e'><marimo-code-editor data-initial-value='&quot;import math&#92;n&#92;ndef standard_error(std_dev, sample_size):&#92;n    return std_dev / math.sqrt(sample_size)&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='150' data-show-copy-button='true' data-debounce=