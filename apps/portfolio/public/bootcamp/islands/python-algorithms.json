_plan = {&#92;n    &#92;&quot;normal&#92;&quot;: &#92;&quot;representative input&#92;&quot;,&#92;n    &#92;&quot;empty&#92;&quot;: &#92;&quot;empty input&#92;&quot;,&#92;n    &#92;&quot;boundary&#92;&quot;: &#92;&quot;one item or smallest valid size&#92;&quot;,&#92;n    &#92;&quot;invalid&#92;&quot;: &#92;&quot;invalid parameter&#92;&quot;,&#92;n}&#92;ncomplexity = &#92;&quot;O(n)&#92;&quot;&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='180' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='wtAr-1' random-id='8dc8babb-29df-9b24-2415-6d147eeda02f'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_namespace%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_namespace%20%3D%20execute_submission(source)%0A%20%20%20%20assert%20set(_namespace.get(%22test_plan%22%2C%20%7B%7D))%20%3D%3D%20%7B%22normal%22%2C%20%22empty%22%2C%20%22boundary%22%2C%20%22invalid%22%7D%2C%20%22include%20all%20four%20test%20categories%22%0A%20%20%20%20assert%20_namespace.get(%22