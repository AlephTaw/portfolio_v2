          "id": "python-algorithms-stacks-queues-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"nebC\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='c5609e90-3656-452f-e357-11dca1b83647' random-id='c5609e90-3656-452f-e357-11dca1b83647'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _namespace: None)&#92;ndef _submission(source):&#92;n    _namespace = execute_submission(source)&#92;n    _function = _namespace[&#92;&quot;is_valid_parentheses&#92;&quot;]&#92;n    assert _function(&#92;&quot;([]{})&#92;&quot;) is True, &#92;&quot;valid nesting was rejected&#92;&quot;&#92;n    assert _function(&#92;&quot;([)]&#92;&quot;) is False, &#92;&quot;crossed nesting was accepted&#92;&quot;&#92;n    assert _function(&#92;&quot;abc&#92;&quot;) is False, &#92;&quot;non-bracket characters should be invalid&#92;&quot;&#92;n    return _namespace&#92;n&#92;nproblem(mo, exercise_05_description__python_algorithms_stacks_queues, exercise_05_starter__python_algorithms_stacks_queues, _submission, exercise_05_submit__python_algorithms_stacks_queues)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Define <code>is_valid_parentheses(text)</code> for <code>()</code>, <code>[]</code>, and <code>{}</code>. Ignore no\ncharacters: any non-bracket character should make the input invalid.</span></span><marimo-ui-element object-id='NtNR-0' random-id='a5f6865d-0e65-7456-6ff2-6f443fd0f4ed'><marimo-code-editor data-initial-value='&quot;def is_valid_parentheses(text):&#92;n    pairs = {&#92;&quot;)&#92;&quot;: &#92;&quot;(&#92;&quot;, &#92;&quot;]&#92;&quot;: &#92;&quot;[&#92;&quot;, &#92;&quot;}&#92;&quot;: &#92;&quot;{&#92;&quot;}&#92;n    stack = []&#92;n    for character in text:&#92;n        if character in &#92;&quot;([{&#92;&quot;:&#92;n            stack.append(character)&#92;n        elif character in pairs:&#92;n            if not stack or stack.pop() != pairs[character]:&#92;n                return False&#92;n        else:&#92;n            return False&#92;n    return not stack&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='250' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='NtNR-1' random-id='a29b7ea1-1262-29e8-272f-1bf90a129bed'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_namespace%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_namespace%20%3D%20execute_submission(source)%0A%20%20%20%20_function%20%3D%20_namespace%5B%22is_valid_parentheses%22%5D%0A%20%20%20%20assert%20_function(%22(%5B%5D%7B%7D)%22)%20is%20True%2C%20%22valid%20nesting%20was%20rejected%22%0A%20%20%20%20assert%20_function(%22(%5B)%5D%22)%20is%20False%2C%20%22crossed%20nesting%20was%20accepted%22%0A%20%20%20%20assert%20_function(%22abc%22)%20is%20False%2C%20%22non-bracket%20characters%20should%20be%20invalid%22%0A%20%20%20%20return%20_namespace%0A%0Aproblem(mo%2C%20exercise_05_description__python_algorithms_stacks_queues%2C%20exercise_05_starter__python_algorithms_stacks_queues%2C%20_submission%2C%20exercise_05_submit__python_algorithms_stacks_queues)</marimo-cell-code>\n        </marimo-island>",
