        {
          "id": "python-algorithms-heaps-top-k-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"LdJG\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='30e5d8f0-8f96-74b2-c8ec-cd89856e4e8b' random-id='30e5d8f0-8f96-74b2-c8ec-cd89856e4e8b'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _namespace: None)&#92;ndef _submission(source):&#92;n    _namespace = execute_submission(source)&#92;n    _function = _namespace[&#92;&quot;top_k_frequent&#92;&quot;]&#92;n    assert _function([&#92;&quot;a&#92;&quot;, &#92;&quot;b&#92;&quot;, &#92;&quot;a&#92;&quot;, &#92;&quot;c&#92;&quot;, &#92;&quot;b&#92;&quot;, &#92;&quot;a&#92;&quot;], 2) == [&#92;&quot;a&#92;&quot;, &#92;&quot;b&#92;&quot;], &#92;&quot;top-k result is incorrect&#92;&quot;&#92;n    assert _function([1, 1, 2], 5) == [1, 2], &#92;&quot;handle k larger than unique values&#92;&quot;&#92;n    return _namespace&#92;n&#92;nproblem(mo, exercise_07_description__python_algorithms_heaps_top_k, exercise_07_starter__python_algorithms_heaps_top_k, _submission, exercise_07_submit__python_algorithms_heaps_top_k)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Define <code>top_k_frequent(values, k)</code> returning the <code>k</code> most frequent values\nin descending frequency order. Ties may be resolved lexicographically.</span></span><marimo-ui-element object-id='qJXu-0' random-id='11c6a64b-94e7-5736-a91d-fd2284685164'><marimo-code-editor data-initial-value='&quot;from collections import Counter&#92;n&#92;ndef top_k_frequent(values, k):&#92;n    counts = Counter(values)&#92;n    return [value for value, _count in sorted(counts.items(), key=lambda item: (-item[1], item[0]))[:k]]&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='190' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='qJXu-1' random-id='73445aa4-cbd9-d2cd-9039-47ab72822e1e'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_namespace%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_namespace%20%3D%20execute_submission(source)%0A%20%20%20%20_function%20%3D%20_namespace%5B%22top_k_frequent%22%5D%0A%20%20%20%20assert%20_function(%5B%22a%22%2C%20%22b%22%2C%20%22a%22%2C%20%22c%22%2C%20%22b%22%2C%20%22a%22%5D%2C%202)%20%3D%3D%20%5B%22a%22%2C%20%22b%22%5D%2C%20%22top-k%20result%20is%20incorrect%22%0A%20%20%20%20assert%20_function(%5B1%2C%201%2C%202%5D%2C%205)%20%3D%3D%20%5B1%2C%202%5D%2C%20%22handle%20k%20larger%20than%20unique%20values%22%0A%20%20%20%20return%20_namespace%0A%0Aproblem(mo%2C%20exercise_07_description__python_algorithms_heaps_top_k%2C%20exercise_07_starter__python_algorithms_heaps_top_k%2C%20_submission%2C%20exercise_07_submit__python_algorithms_heaps_top_k)</marimo-cell-code>\n        </marimo-island>",
