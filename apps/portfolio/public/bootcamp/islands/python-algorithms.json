        {
          "id": "python-algorithms-trees-graphs-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"DlKN\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='351d3c00-8a1f-b52c-d362-664595d55609' random-id='351d3c00-8a1f-b52c-d362-664595d55609'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _namespace: None)&#92;ndef _submission(source):&#92;n    _namespace = execute_submission(source)&#92;n    _graph = {&#92;&quot;a&#92;&quot;: [&#92;&quot;b&#92;&quot;, &#92;&quot;c&#92;&quot;], &#92;&quot;b&#92;&quot;: [&#92;&quot;d&#92;&quot;], &#92;&quot;c&#92;&quot;: [&#92;&quot;d&#92;&quot;], &#92;&quot;d&#92;&quot;: []}&#92;n    _function = _namespace[&#92;&quot;shortest_path&#92;&quot;]&#92;n    assert _function(_graph, &#92;&quot;a&#92;&quot;, &#92;&quot;d&#92;&quot;) == 2, &#92;&quot;shortest path length is incorrect&#92;&quot;&#92;n    assert _function(_graph, &#92;&quot;a&#92;&quot;, &#92;&quot;x&#92;&quot;) is None, &#92;&quot;unreachable goal should return None&#92;&quot;&#92;n    return _namespace&#92;n&#92;nproblem(mo, exercise_06_description__python_algorithms_trees_graphs, exercise_06_starter__python_algorithms_trees_graphs, _submission, exercise_06_submit__python_algorithms_trees_graphs)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Define <code>shortest_path(graph, start, goal)</code> returning the number of edges\nin the shortest unweighted path, or <code>None</code> when unreachable.</span></span><marimo-ui-element object-id='bhgI-0' random-id='f4d7de05-bb07-0aa5-979d-d262e3f86975'><marimo-code-editor data-initial-value='&quot;from collections import deque&#92;n&#92;ndef shortest_path(graph, start, goal):&#92;n    queue = deque([(start, 0)])&#92;n    visited = {start}&#92;n    while queue:&#92;n        node, distance = queue.popleft()&#92;n        if node == goal:&#92;n            return distance&#92;n        for neighbor in graph.get(node, []):&#92;n            if neighbor not in visited:&#92;n                visited.add(neighbor)&#92;n                queue.append((neighbor, distance + 1))&#92;n    return None&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='270' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='bhgI-1' random-id='53049530-263f-91e0-c965-b06705172b4e'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_namespace%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_namespace%20%3D%20execute_submission(source)%0A%20%20%20%20_graph%20%3D%20%7B%22a%22%3A%20%5B%22b%22%