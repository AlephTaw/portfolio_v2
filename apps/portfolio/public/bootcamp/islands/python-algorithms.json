        {
          "id": "python-algorithms-complexity-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"ynmH\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='4eccd7ac-2fb3-acc7-9a59-fb7c7dcc4bad' random-id='4eccd7ac-2fb3-acc7-9a59-fb7c7dcc4bad'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _namespace: None)&#92;ndef _submission(source):&#92;n    _namespace = execute_submission(source)&#92;n    assert _namespace.get(&#92;&quot;complexities&#92;&quot;) == {&#92;n        &#92;&quot;single_pass&#92;&quot;: &#92;&quot;O(n)&#92;&quot;,&#92;n        &#92;&quot;nested_passes&#92;&quot;: &#92;&quot;O(n^2)&#92;&quot;,&#92;n        &#92;&quot;sort&#92;&quot;: &#92;&quot;O(n log n)&#92;&quot;,&#92;n        &#92;&quot;binary_search&#92;&quot;: &#92;&quot;O(log n)&#92;&quot;,&#92;n    }, &#92;&quot;check each complexity label&#92;&quot;&#92;n    return _namespace&#92;n&#92;nproblem(mo, exercise_01_description__python_algorithms_complexity, exercise_01_starter__python_algorithms_complexity, _submission, exercise_01_submit__python_algorithms_complexity)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Create <code>complexities</code> mapping these patterns to their usual time\ncomplexity: <code>single_pass</code>, <code>nested_passes</code>, <code>sort</code>, and <code>binary_search</code>.\nUse values <code>O(n)</code>, <code>O(n^2)</code>, <code>O(n log n)</code>, and <code>O(log n)</code> respectively.</span></span><marimo-ui-element object-id='RCUM-0' random-id='1bad6fc0-5cb6-7b31-773c-1c867a008fe9'><marimo-code-editor data-initial-value='&quot;complexities = {&#92;n    &#92;&quot;single_pass&#92;&quot;: &#92;&quot;O(n)&#92;&quot;,&#92;n    &#92;&quot;nested_passes&#92;&quot;: &#92;&quot;O(n^2)&#92;&quot;,&#92;n    &#92;&quot;sort&#92;&quot;: &#92;&quot;O(n log n)&#92;&quot;,&#92;n    &#92;&quot;binary_search&#92;&quot;: &#92;&quot;O(log n)&#92;&quot;,&#92;n}&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='170' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='RCUM-1' random-id='99bab621-abb6-09ff-0cbf-8a547849b236'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_namespace%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_namespace%20%3D%20execute_submission(source)%0A%20%20%20%20assert%20_namespace.get(%22complexities%22)%20%3D%3D%20%7B%0A%20%20%20%20%20%20%20%20%22single_pass%22%3A%20%22O(n)%22%2C%0A%20%20%20%20%20%20%20%20%22nested_passes%22%3A%20%22O(n%5E2)%22%2C%0A%20%20%20%20%20%20%20%20%22sort%22%3A%20%22O(n%20log%20n)%22%2C%0A%20%20%20%20%20%20%20%20%22binary_search%22%3A%20%22O(log%20n)%22%2C%0A%20%20%20%20%7D%2C%20%22check%20each%20complexity%20label%22%0A%20%20%20%20return%20_namespace%0A%0Aproblem(mo%2C%20exercise_01_description__python_algorithms_complexity%2C%20exercise_01_starter__python_algorithms_complexity%2C%20_submission%2C%20exercise_01_submit__python_algorithms_complexity)</marimo-cell-code>\n        </marimo-island>",
