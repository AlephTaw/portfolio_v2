          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"TzTD\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='0ba5403f-5412-4c0f-3f67-3e365989c1a0' random-id='0ba5403f-5412-4c0f-3f67-3e365989c1a0'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    assert _ns.get(&#92;&quot;pipeline_order&#92;&quot;) == [&#92;&quot;split&#92;&quot;, &#92;&quot;fit_transform_train&#92;&quot;, &#92;&quot;transform_validation&#92;&quot;, &#92;&quot;fit_model&#92;&quot;], &#92;&quot;pipeline order leaks validation information&#92;&quot;&#92;n    return _ns&#92;n&#92;nproblem(mo, ml_exercise_05_description, ml_exercise_05_starter, _submission, ml_exercise_05_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Create <code>pipeline_order</code> listing the four leakage-safe steps in order:\n<code>split</code>, <code>fit_transform_train</code>, <code>transform_validation</code>, <code>fit_model</code>.</span></span><marimo-ui-element object-id='YCKg-0' random-id='2e181f9c-f4f3-64d8-1e6e-7767d9cb11f5'><marimo-code-editor data-initial-value='&quot;pipeline_order = [&#92;n    &#92;&quot;split&#92;&quot;,&#92;n    &#92;&quot;fit_transform_train&#92;&quot;,&#92;n    &#92;&quot;transform_validation&#92;&quot;,&#92;n    &#92;&quot;fit_model&#92;&quot;,&#92;n]&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark