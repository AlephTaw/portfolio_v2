        {
          "id": "ml-problem-framing-splits-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"nSRe\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='46a2765a-ca8d-91a3-409f-d5b146ae3ee2' random-id='46a2765a-ca8d-91a3-409f-d5b146ae3ee2'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _fn = _ns[&#92;&quot;split_strategy&#92;&quot;]&#92;n    assert _fn(&#92;&quot;forecast&#92;&quot;) == &#92;&quot;time&#92;&quot;, &#92;&quot;forecasting needs a temporal split&#92;&quot;&#92;n    assert _fn(&#92;&quot;repeated_users&#92;&quot;) == &#92;&quot;group&#92;&quot;, &#92;&quot;repeated entities need a group split&#92;&quot;&#92;n    assert _fn(&#92;&quot;iid&#92;&quot;) == &#92;&quot;random&#92;&quot;, &#92;&quot;exchangeable observations may use a random split&#92;&quot;&#92;n    return _ns&#92;n&#92;nproblem(mo, ml_exercise_01_description, ml_exercise_01_starter, _submission, ml_exercise_01_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Create <code>split_strategy(problem)</code> returning <code>\"time\"</code> for future forecasting,\n<code>\"group\"</code> for repeated users, and <code>\"random\"</code> otherwise.</span></span><marimo-ui-element object-id='BzwM-0' random-id='0d0ed821-08cc-2d01-816c-e504e1e5fdc0'><marimo-code-editor data-initial-value='&quot;def split_strategy(problem):&#92;n    if problem == &#92;&quot;forecast&#92;&quot;:&#92;n        return &#92;&quot;time&#92;&quot;&#92;n    if problem == &#92;&quot;repeated_users&#92;&quot;:&#92;n        return &#92;&quot;group&#92;&quot;&#92;n    return &#92;&quot;random&#92;&quot;&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='170' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='BzwM-1' random-id='492a50f5-2b62-2d89-62f5-97ba3ebe1ff3'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_ns%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_ns%20%3D%20execute_submission(source)%0A%20%20%20%20_fn%20%3D%20_ns%5B%22split_strategy%22%5D%0A%20%20%20%20assert%20_fn(%22forecast%22)%20%3D%3D%20%22time%22%2C%20%22forecasting%20needs%20a%20temporal%20split%22%0A%20%20%20%20assert%20_fn(%22repeated_users%22)%20%3D%3D%20%22group%22%2C%20%22repeated%20entities%20need%20a%20group%20split%22%0A%20%20%20%20assert%20_fn(%22iid%22)%20%3D%3D%20%22random%22%2C%20%22exchangeable%20observations%20may%20use%20a%20random%20split%22%0A%20%20%20%20return%20_ns%0A%0Aproblem(mo%2C%20ml_exercise_01_description%2C%20ml_exercise_01_starter%2C%20_submission%2C%20ml_exercise_01_submit)</marimo-cell-code>\n        </marimo-island>",
