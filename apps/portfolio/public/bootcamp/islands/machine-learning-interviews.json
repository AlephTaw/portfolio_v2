        {
          "id": "ml-unsupervised-dimensionality-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"MXkk\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='ca10d915-ea5f-ad10-5f4e-b8754e736596' random-id='ca10d915-ea5f-ad10-5f4e-b8754e736596'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _fn = _ns[&#92;&quot;unsupervised_tool&#92;&quot;]&#92;n    assert _fn(&#92;&quot;segmentation&#92;&quot;) == &#92;&quot;kmeans&#92;&quot;, &#92;&quot;segmentation choice is incorrect&#92;&quot;&#92;n    assert _fn(&#92;&quot;dimensionality_reduction&#92;&quot;) == &#92;&quot;pca&#92;&quot;, &#92;&quot;dimensionality choice is incorrect&#92;&quot;&#92;n    return _ns&#92;n&#92;nproblem(mo, ml_exercise_07_description, ml_exercise_07_starter, _submission, ml_exercise_07_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Define <code>unsupervised_tool(goal)</code> returning <code>\"kmeans\"</code> for segmentation and\n<code>\"pca\"</code> for linear dimensionality reduction.</span></span><marimo-ui-element object-id='ZpGF-0' random-id='87e99372-bef4-0e38-cbc9-0cf5e5b7ffb7'><marimo-code-editor data-initial-value='&quot;def unsupervised_tool(goal):&#92;n    if goal == &#92;&quot;segmentation&#92;&quot;:&#92;n        return &#92;&quot;kmeans&#92;&quot;&#92;n    if goal == &#92;&quot;dimensionality_reduction&#92;&quot;:&#92;n        return &#92;&quot;pca&#92;&quot;