          "id": "ml-problem-framing-splits-block-3",
          "html": "<marimo-island\n    data-app-id=\"mlphd\"\n    data-cell-id=\"BzwM\"\n    data-reactive=\"true\"\n>\n    <marimo-cell-output>\n    <span></span>\n    </marimo-cell-output>\n    <marimo-cell-code hidden>ml_exercise_01_description%20%3D%20mo.md(%22%22%22%0A%23%23%23%20Exercise%0A%0ACreate%20%60split_strategy(problem)%60%20returning%20%60%22time%22%60%20for%20future%20forecasting%2C%0A%60%22group%22%60%20for%20repeated%20users%2C%20and%20%60%22random%22%60%20otherwise.%0A%22%22%22)%0Aml_exercise_01_starter%20%3D%20mo.ui.code_editor(%0A%20%20%20%20value%3D'def%20split_strategy(problem)%3A%5Cn%20%20%20%20if%20problem%20%3D%3D%20%22forecast%22%3A%5Cn%20%20%20%20%20%20%20%20return%20%22time%22%5Cn%20%20%20%20if%20problem%20%3D%3D%20%22repeated_users%22%3A%5Cn%20%20%20%20%20%20%20%20return%20%22group%22%5Cn%20%20%20%20return%20%22random%22'%2C%0A%20%20%20%20language%3D%22python%22%2C%20label%3D%22Your%20Python%20answer%22%2C%20min_height%3D170%2C%0A)%0Aml_exercise_01_submit%20%3D%20mo.ui.run_button(label%3D%22Submit%20answer%22)</marimo-cell-code>\n</marimo-island>",
