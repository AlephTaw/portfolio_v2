        {
          "id": "ml-linear-logistic-regularization-block-3",
          "html": "<marimo-island\n    data-app-id=\"mlphd\"\n    data-cell-id=\"lPrT\"\n    data-reactive=\"true\"\n>\n    <marimo-cell-output>\n    <span></span>\n    </marimo-cell-output>\n    <marimo-cell-code hidden>ml_exercise_02_description%20%3D%20mo.md(%22%22%22%0A%23%23%23%20Exercise%0A%0ADefine%20%60sigmoid(score)%60%20without%20external%20libraries%20and%20%60penalty(use_sparse)%60%0Areturning%20%60%22l1%22%60%20when%20sparsity%20is%20desired%20and%20%60%22l2%22%60%20otherwise.%0A%22%22%22)%0Aml_exercise_02_starter%20%3D%20mo.ui.code_editor(%0A%20%20%20%20value%3D'import%20math%5Cn%5Cndef%20sigmoid(score)%3A%5Cn%20%20%20%20return%201%20%2F%20(1%20%2B%20math.exp(-score))%5Cn%5Cndef%20penalty(use_sparse)%3A%5Cn%20%20%20%20return%20%22l1%22%20if%20use_sparse%20else%20%22l2%22'%2C%0A%20%20%20%20language%3D%22python%22%2C%20label%3D%22Your%20Python%20answer%22%2C%20min_height%3D180%2C%0A)%0Aml_exercise_02_submit%20%3D%20mo.ui.run_button(label%3D%22Submit%20answer%22)</marimo-cell-code>\n</marimo-island>",
          "visible": false
        },
        {
          "id": "ml-linear-logistic-regularization-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"KoaX\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='d336974f-ea28-1502-68f3-b53ffe9f7474' random-id='d336974f-ea28-1502-68f3-b53ffe9f7474'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    assert abs(_ns[&#92;&quot;sigmoid&#92;&quot;](0) - 0.5) &#92;u003c 1e-12, &#92;&quot;sigmoid(0) should be 0.5&#92;&quot;&#92;n    assert _ns[&#92;&quot;sigmoid&#92;&quot;](3) &#92;u003e _ns[&#92;&quot;sigmoid&#92;&quot;](-3), &#92;&quot;sigmoid must be increasing&#92;&quot;&#92;n    assert _ns[&#92;&quot;penalty&#92;&quot;](True) == &#92;&quot;l1&#92;&quot; and _ns[&#92;&quot;penalty&#92;&quot;](False) == &#92;&quot;l2&#92;&quot;, &#92;&quot;penalty choice is incorrect&#92;&quot;&#92;n    return _ns&#92;n&#92;nproblem(mo, ml_exercise_02_description, ml_exercise_02_starter, _submission, ml_exercise_02_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Define <code>sigmoid(score)</code> without external libraries and <code>penalty(use_sparse)</code>\nreturning <code>\"l1\"</code> when sparsity is desired and <code>\"l2\"</code> otherwise.</span></span><marimo-ui-element object-id='lPrT-0' random-id='d5be7b07-ff04-ad19-d64f-6d50786acccd'><marimo-code-editor data-initial-value='&quot;import math&#92;n&#92;ndef sigmoid(score):&#92;n    return 1 / (1 + math.exp(-score))&#92;n&#92;ndef penalty(use_sparse):&#92;n    return &#92;&quot;l1&#92;&quot; if use_sparse else &#92;&quot;l2&#92;&quot;&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='180' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='lPrT-1' random-id='5b690f0e-c168-f7c2-008c-91754f0db6a9'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_ns%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_ns%20%3D%20execute_submission(source)%0A%20%20%20%20assert%20abs(_ns%5B%22sigmoid%22%5D(0)%20-%200.5)%20%3C%201e-12%2C%20%22sigmoid(0)%20should%20be%200.5%22%0A%20%20%20%20assert%20_ns%5B%22sigmoid%22%5D(3)%20%3E%20_ns%5B%22sigmoid%22%5D(-3)%2C%20%22sigmoid%20must%20be%20increasing%22%0A%20%20%20%20assert%20_ns%5B%22penalty%22%5D(True)%20%3D%3D%20%22l1%22%20and%20_ns%5B%22penalty%22%5D(False)%20%3D%3D%20%22l2%22%2C%20%22penalty%20choice%20is%20incorrect%22%0A%20%20%20%20return%20_ns%0A%0Aproblem(mo%2C%20ml_exercise_02_description%2C%20ml_exercise_02_starter%2C%20_submission%2C%20ml_exercise_02_submit)</marimo-cell-code>\n        </marimo-island>",
          "visible": true
        }
