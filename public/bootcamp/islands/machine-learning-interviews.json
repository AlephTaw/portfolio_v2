          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"MXkk\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='0e06193c-0c95-de3c-7e6c-b030c3cb7c01' random-id='0e06193c-0c95-de3c-7e6c-b030c3cb7c01'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _fn = _ns[&#92;&quot;unsupervised_tool&#92;&quot;]&#92;n    assert _fn(&#92;&quot;segmentation&#92;&quot;) == &#92;&quot;kmeans&#92;&quot;, &#92;&quot;segmentation choice is incorrect&#92;&quot;&#92;n    assert _fn(&#92;&quot;dimensionality_reduction&#92;&quot;) == &#92;&quot;pca&#92;&quot;, &#92;&quot;dimensionality choice is incorrect&#92;&quot;&#92;n    return _ns&#92;n&#92;nproblem(mo, ml_exercise_07_description, ml_exercise_07_starter, _submission, ml_exercise_07_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Define <code>unsupervised_tool(goal)</code> returning <code>\"kmeans\"</code> for segmentation and\n<code>\"pca\"</code> for linear dimensionality reduction.</span></span><marimo-ui-element object-id='ZpGF-0' random-id='82f1d374-6aff-c3e0-8117-84a330f7ddd9'><marimo-code-editor data-initial-value='&quot;def unsupervised_tool(goal):&#92;n    if goal == &#92;&quot;segmentation&#92;&quot;:&#92;n        return &#92;&quot;kmeans&#92;&quot;&#92;n    if goal == &#92;&quot;dimensionality_reduction&#92;&quot;:&#92;n        return &#92;&quot;pca&#92;&quot;