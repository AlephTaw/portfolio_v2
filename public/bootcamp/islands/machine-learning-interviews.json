          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"JWOG\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='f9b31bea-617f-bd41-8776-ec10cccf6971' random-id='f9b31bea-617f-bd41-8776-ec10cccf6971'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _fn = _ns[&#92;&quot;drift_type&#92;&quot;]&#92;n    assert _fn(True, False) == &#92;&quot;data&#92;&quot;, &#92;&quot;input-distribution change is data drift&#92;&quot;&#92;n    assert _fn(False, True) == &#92;&quot;concept&#92;&quot;, &#92;&quot;relationship change is concept drift&#92;&quot;&#92;n    assert _fn(False, False) == &#92;&quot;none&#92;&quot;, &#92;&quot;unchanged behavior means no detected drift&#92;&quot;&#92;n    return _ns&#92;n&#92;nproblem(mo, ml_exercise_08_description, ml_exercise_08_starter, _submission, ml_exercise_08_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Define <code>drift_type(input_changed, relationship_changed)</code> returning\n<code>\"concept\"</code> when the input-to-target relationship changed, <code>\"data\"</code> when\nonly the input distribution changed, and <code>\"none\"</code> otherwise.</span></span><marimo-ui-element object-id='mKKx-0' random-id='2009e5d2-3891-336e-9655-c00dd88083f2'><marimo-code-editor data-initial-value='&quot;def drift_type(input_changed, relationship_changed):&#92;n    if relationship_changed:&#92;n        return &#92;&quot;concept&#92;&quot;&#92;n    if input_changed:&#92;n        return &#92;&quot;data&#92;&quot;&#92;n    return &#92;&quot;none&#92;&quot;&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='160' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='mKKx-1' random-id='d97e2c1d-ec52-6fe5-7aaa-c36f8f0279b3'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_ns%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_ns%20%3D%20execute_submission(source)%0A%20%20%20%20_fn%20%3D%20_ns%5B%22drift_type%22%5D%0A%20%20%20%20assert%20_fn(True%2C%20False)%20%3D%3D%20%22data%22%2C%20%22input-distribution%20change%20is%20data%20drift%22%0A%20%20%20%20assert%20_fn(False%2C%20True)%20%3D%3D%20%22concept%22%2C%20%22relationship%20change%20is%20concept%20drift%22%0A%20%20%20%20assert%20_fn(False%2C%20False)%20%3D%3D%20%22none%22%2C%20%22unchanged%20behavior%20means%20no%20detected%20drift%22%0A%20%20%20%20return%20_ns%0A%0Aproblem(mo%2C%20ml_exercise_08_description%2C%20ml_exercise_08_starter%2C%20_submission%2C%20ml_exercise_08_submit)</marimo-cell-code>\n        </marimo-island>",
