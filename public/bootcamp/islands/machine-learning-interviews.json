        {
          "id": "ml-classification-metrics-thresholds-block-4",
          "html": "<marimo-island\n            data-app-id=\"mlphd\"\n            data-cell-id=\"zLYB\"\n            data-reactive=\"true\"\n        >\n            <marimo-cell-output><marimo-ui-element data-mlphd-island-source-guard hidden object-id='e27cacf7-7479-4f34-d5dc-f9424e66aaa7' random-id='e27cacf7-7479-4f34-d5dc-f9424e66aaa7'><marimo-code-editor data-initial-value='&quot;@assertion(lambda _ns: None)&#92;ndef _submission(source):&#92;n    _ns = execute_submission(source)&#92;n    _metrics = _ns[&#92;&quot;classification_metrics&#92;&quot;](8, 2, 4)&#92;n    assert abs(_metrics[&#92;&quot;precision&#92;&quot;] - 0.8) &#92;u003c 1e-12, &#92;&quot;precision is incorrect&#92;&quot;&#92;n    assert abs(_metrics[&#92;&quot;recall&#92;&quot;] - 2 / 3) &#92;u003c 1e-12, &#92;&quot;recall is incorrect&#92;&quot;&#92;n    assert abs(_metrics[&#92;&quot;f1&#92;&quot;] - 8 / 11) &#92;u003c 1e-12, &#92;&quot;F1 is incorrect&#92;&quot;&#92;n    return _ns&#92;n&#92;nproblem(mo, ml_exercise_04_description, ml_exercise_04_starter, _submission, ml_exercise_04_submit)&quot;' data-label='null' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element>\n            <div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 1rem'><span class=\"markdown prose dark:prose-invert contents\"><h3 id=\"exercise\">Exercise</h3>\n<span class=\"paragraph\">Define <code>classification_metrics(tp, fp, fn)</code> returning a dictionary with\n<code>precision</code>, <code>recall</code>, and <code>f1</code>. Return <code>0.0</code> when a denominator is zero.</span></span><marimo-ui-element object-id='BNjl-0' random-id='e52b9238-0337-4f03-f013-34870a04192c'><marimo-code-editor data-initial-value='&quot;def classification_metrics(tp, fp, fn):&#92;n    precision = tp / (tp + fp) if tp + fp else 0.0&#92;n    recall = tp / (tp + fn) if tp + fn else 0.0&#92;n    f1 = 2 * precision * recall / (precision + recall) if precision + recall else 0.0&#92;n    return {&#92;&quot;precision&#92;&quot;: precision, &#92;&quot;recall&#92;&quot;: recall, &#92;&quot;f1&#92;&quot;: f1}&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eYour Python answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-language='&quot;python&quot;' data-placeholder='&quot;&quot;' data-disabled='false' data-min-height='190' data-show-copy-button='true' data-debounce='false'></marimo-code-editor></marimo-ui-element><marimo-ui-element object-id='BNjl-1' random-id='9efb59c5-bbf2-6d92-215c-e166e0a5a875'><marimo-button data-initial-value='0' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eSubmit answer&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;' data-disabled='false' data-full-width='false'></marimo-button></marimo-ui-element><marimo-callout-output data-html='&quot;&#92;u003cspan&#92;u003eEdit the answer, then click Submit answer.&#92;u003c/span&#92;u003e&quot;' data-kind='&quot;neutral&quot;'></marimo-callout-output></div>\n            </marimo-cell-output>\n            <marimo-cell-code hidden>%40assertion(lambda%20_ns%3A%20None)%0Adef%20_submission(source)%3A%0A%20%20%20%20_ns%20%3D%20execute_submission(source)%0A%20%20%20%20_metrics%20%3D%20_ns%5B%22classification_metrics%22%5D(8%2C%202%2C%204)%0A%20%20%20%20assert%20abs(_metrics%5B%22precision%22%5D%20-%200.8)%20%3C%201e-12%2C%20%22precision%20is%20incorrect%22%0A%20%20%20%20assert%20abs(_metrics%5B%22recall%22%5D%20-%202%20%2F%203)%20%3C%201e-12%2C%20%22recall%20is%20incorrect%22%0A%20%20%20%20assert%20abs(_metrics%5B%22f1%22%5D%20-%208%20%2F%2